# PROD environment - same database names (RETAIL_STG, RETAIL_DWH) on the production server
SQL_SERVER=YOUR_PROD_SERVER

# windows = use your Windows login (no password)
# sql     = use SQL_USERNAME and SQL_PASSWORD
SQL_LOGIN=windows
SQL_USERNAME=
SQL_PASSWORD=

INBOX_FOLDER=data/prod/inbox
ARCHIVE_FOLDER=data/prod/archive
ERROR_FOLDER=data/prod/error
